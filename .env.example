# kg-viewer server port (default 8090)
KG_VIEWER_PORT=8090

# Neo4j connection — leave NEO4J_URI empty to serve viewer with sample data.
# With KG_GRAPH_PROFILE set, the profile-specific URI below takes precedence.
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-healthdinner-2026
NEO4J_DATABASE=neo4j

# Graph profile switch. The active profile selects both the M3 instance and
# the display language. v2/v3 profiles use the same bilingual database shape
# within their selected dataset version.
KG_GRAPH_PROFILE=v2-zh

# v2: one Community instance (7689) with bilingual properties in one graph.
KG_GRAPH_V2_URI=bolt://192.168.31.201:7689
KG_GRAPH_V2_DATABASE=neo4j

# v3: Outcome/outcome_id replaces v2 HealthTopic/topic_id on the same port.
KG_GRAPH_V3_URI=bolt://192.168.31.201:7689
KG_GRAPH_V3_DATABASE=neo4j

# Legacy Community instances: one process/database per language.
KG_GRAPH_LEGACY_EN_URI=bolt://192.168.31.201:7687
KG_GRAPH_LEGACY_EN_DATABASE=neo4j
KG_GRAPH_LEGACY_ZH_URI=bolt://192.168.31.201:7688
KG_GRAPH_LEGACY_ZH_DATABASE=neo4j

# Backward-compatible single-target configuration when KG_GRAPH_PROFILE is empty.
# NEO4J_URI=bolt://127.0.0.1:7687
# DB_LANG=zh
#
# Profile examples:
# KG_GRAPH_PROFILE=legacy-en
# KG_GRAPH_PROFILE=legacy-zh
# KG_GRAPH_PROFILE=v2-en
# KG_GRAPH_PROFILE=v2-zh
# KG_GRAPH_PROFILE=v3-en
# KG_GRAPH_PROFILE=v3-zh
