# kg-viewer server port (default 8090)
KG_VIEWER_PORT=8090

# Neo4j connection — leave NEO4J_URI empty to serve viewer with sample data
# (GET /v1/graph/kg returns 503; the 3D page auto-falls back to built-in sample).
#
# 场景 A：本地 Docker 示例（make neo4j-up && make neo4j-seed 灌入示例数据）
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-healthdinner-2026
NEO4J_DATABASE=neo4j
#
# 场景 B：M3 机器上的真实营养证据知识图谱（Homebrew Neo4j 2026.06.0）
# 数据来源：nutrition-evidence-kg 项目导入。切换时注释掉场景 A，取消注释：
#NEO4J_URI=bolt://192.168.31.201:7687
#NEO4J_USER=neo4j
#NEO4J_PASSWORD=neo4j-healthdinner-2026
#NEO4J_DATABASE=neo4j
