# kg-viewer server port (default 8090)
KG_VIEWER_PORT=8090

# Neo4j connection — leave NEO4J_URI empty to serve viewer with sample data only
# (GET /v1/graph/kg returns 503; the 3D page auto-falls back to built-in sample).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthdinner123
NEO4J_DATABASE=neo4j
